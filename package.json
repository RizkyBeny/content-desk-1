{
  "name": "ai-content-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx watch worker/index.ts",
    "worker:prod": "tsx worker/index.ts",
    "db:generate": "prisma generate",
    "db:generate:sqlite": "node scripts/make-sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma",
    "db:sqlite": "node scripts/make-sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma && prisma db push --schema prisma/schema.sqlite.prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "assets:fetch": "node scripts/fetch-unsplash.mjs",
    "media:regen": "tsx scripts/regen-media.ts",
    "demo:gallery": "tsx scripts/seed-demo-gallery.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroui/react": "^3.0.0",
    "@heroui/styles": "^3.0.0",
    "@prisma/client": "^6.2.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "clsx": "^2.1.1",
    "docx": "^9.12.0",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "jszip": "^3.10.2",
    "konva": "^10.9.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.3.0",
    "react-dropzone": "^14.4.1",
    "react-konva": "^19.3.2",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "wavesurfer.js": "^8.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^6.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
