# ─────────────────────────────────────────────────────────────
# AI Content Creator Platform — Environment
# Copy to `.env` and fill values. All external integrations default
# to mock adapters so the platform runs without any API key.
# ─────────────────────────────────────────────────────────────

# Mode data (default: mock jika DATABASE_URL kosong).
#   mock     = tanpa database sama sekali — semua data dari fixture in-memory.
#              Cocok untuk preview front-end / demo end-to-end tanpa BE.
#   database = Prisma asli (MySQL 8 production, SQLite lokal via db:sqlite).
DATA_MODE="mock"

# Database (MySQL 8) — hanya dipakai saat DATA_MODE=database.
# Kosongkan / komentari untuk mode mock.
DATABASE_URL="mysql://root:root@localhost:3306/ai_content_platform"

# Auth — 32+ char secret for session token hashing / signing
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Dev only: set to "true" to skip login entirely (acts as the seeded admin user).
# Keep "false" (or unset) for normal auth behavior.
AUTH_DISABLED="false"
# Public base URL, used for invite links
APP_URL="http://localhost:3000"

# Web Login Gate — Gerbang proteksi akses luar
GATE_ENABLED="true"
GATE_USER="admin"
GATE_PASSWORD="contentdesk2026!"

# Queue backend (Redis). Leave empty to run jobs inline (dev fallback).
REDIS_URL="redis://localhost:6379"

# Object storage. STORAGE_DRIVER=local writes to UPLOAD_DIR (dev fallback).
# Set STORAGE_DRIVER=s3 and fill the S3_* values for S3-compatible / MinIO.
STORAGE_DRIVER="local"
UPLOAD_DIR=".data/uploads"
FILE_SIGNING_SECRET="change-me-to-a-long-random-string-min-32-chars"
# FFMPEG_PATH=""  # optional; defaults to the bundled ffmpeg-static binary
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ai-content"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# ── External providers ───────────────────────────────────────
# Adapter selector. `mock` ships with deterministic fixtures.
AI_PROVIDER="mock"            # mock | openai
SOCIAL_PROVIDER="mock"        # mock | live
TREND_PROVIDER="mock"         # mock | live
STT_PROVIDER="mock"           # mock | live
IMAGE_PROVIDER="mock"         # mock | openai
VIDEO_PROVIDER="mock"         # mock | openai
AUDIO_PROVIDER="mock"         # mock | elevenlabs

# Mock image/video material: "unsplash" (bundled abstract-background photos in
# public/seed/unsplash — run `npm run assets:fetch` once) or "gradient" (SVG posters).
MOCK_MEDIA_SOURCE="unsplash"

# Real credentials (only needed when provider != mock)
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""
GOOGLE_TRENDS_API_KEY=""
YOUTUBE_API_KEY=""
X_API_BEARER_TOKEN=""

# Social OAuth app credentials (only needed when SOCIAL_PROVIDER=live)
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
